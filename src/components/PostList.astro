---
import type { CollectionEntry } from 'astro:content';

type Post = CollectionEntry<'blog'>;

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>
          <span class="post-title">{post.data.title}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .post-list a {
    display: block;
    padding: 0.15rem 0;
    text-decoration: none;
  }
  .post-list a:hover .post-title {
    color: var(--a);
  }
  .post-title {
    font-size: var(--fs);
    color: var(--t);
    transition: color 0.12s;
  }
</style>

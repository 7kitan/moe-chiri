---
import BasePage from "../layouts/BasePage.astro";
---

<BasePage title="Colophon — Kitan">
    <h1>Colophon</h1>

    <section class="colophon-section">
        <h2>Typefaces</h2>
        <ul>
            <li>
                <a href="https://fonts.google.com/specimen/Atkinson+Hyperlegible+Next">Atkinson Hyperlegible Next</a>
            </li>
            <li>
                <a href="https://www.cufonfonts.com/font/iso">ISO v0.6</a> — alternate mono font for text. I like both so I keep it switchable.
            </li>
            <li>
                Kitan Mono — my custom <a href="https://github.com/be5invis/Iosevka">Iosevka</a> build
            </li>
        </ul>
    </section>

    <section class="colophon-section">
        <h2>Static site builder</h2>
        <ul>
            <li>
                <a href="https://astro.build">Astro</a> with pnpm. Posts written in markdown then compiled to upload.
            </li>
            <li>
                Hosted on Cloudflare Pages via the
                Wrangler CLI.
            </li>
        </ul>
    </section>

    <section class="colophon-section">
        <h2>Design</h2>
        <ul>
            <li>
                Light mode: <code>#f8f8f8</code> bg |
                <code>#b84d00</code> accent |
                <code>#2a2d2e</code> text
            </li>
            <li>
              Dark mode: <code>#172713</code> bg |
              <code>#fa9442</code> accent |
                <code>#b5d1cc</code> text
            </li>
            <li>
              Space color and light mode background color is from <a href="https://nipponcolors.com/">Nippon Colors</a>.
              Dark mode color theme taken from <a href="https://sanzo-wada.dmbk.io/combination/229">Wada Sanzo colors</a>.
              I like the orange, but have made it a bit burnt for light mode readability.
            </li>
        </ul>
    </section>
</BasePage>

<style>
    .colophon-section {
      margin: 1.5rem 0;
    }
    .colophon-section h2 {
        font-size: var(--fs);
        margin: 0 0 0.5rem;
    }
    .colophon-section code {
        font-family: var(--s);
        font-size: var(--fs-sm);
        background: var(--b);
        padding: 0.1em 0.3em;
        border-radius: 3px;
    }
</style>
